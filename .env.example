MY_GARDEN_SESSION_SECRET=change-this-to-a-random-secret

# HTTPS via Caddy reverse proxy (automatic Let's Encrypt)
# Create DNS A record: my-garden.yogurtdemora.com -> your-server-ip
# MY_GARDEN_ORIGIN is set in docker-compose.yml

# Optional SMTP for email auth links
# MY_GARDEN_SMTP_HOST=smtp.gmail.com
# MY_GARDEN_SMTP_PORT=587
# MY_GARDEN_SMTP_USER=your-email@gmail.com
# MY_GARDEN_SMTP_PASS=your-app-password
# MY_GARDEN_SMTP_FROM=your-email@gmail.com
